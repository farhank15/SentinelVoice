# ==============================================================================
# SentinelVoice Backend Configuration Template
# AssemblyAI Voice Agent Hackathon 2026
# ==============================================================================

# Fastify Server Port
PORT=8000

# AssemblyAI API Key (Required for live Voice Agent WebSocket & Speech Ingestion)
# Obtain your key from: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Poolside AI API Key (Frontier Reasoning Engine: Poolside Laguna S 2.1)
# Key format starts with sky_... (Endpoint: https://inference.poolside.ai/v1)
LLM_API_KEY=sky_your_poolside_api_key_here

# Google Gemini Multi-Key Fallback (gemini-2.5-flash)
# Automatic rotation and per-key circuit breakers:
GEMINI_API_KEY=AIzaSy_your_primary_gemini_key_here
GEMINI_API_KEY2=AIzaSy_your_secondary_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Out-of-Band Incident Push Alerts (Optional)
# Enter a Slack Incoming Webhook URL to receive live emergency escrow freeze alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Environment Mode
NODE_ENV=development
